        "description",
        "displayName",
        "hidden",
        "id",
        "isDefault",
        "model",
        "supportedReasoningEfforts"
      ],
      "type": "object"
    },
    "ModelAvailabilityNux": {
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "ModelServiceTier": {
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "id",
        "name"
      ],
      "type": "object"
    },
    "ModelUpgradeInfo": {
      "properties": {
        "migrationMarkdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "modelLink": {
          "type": [
            "string",
            "null"
          ]
        },
        "retirementAt": {
          "description": "Informational Unix timestamp for this upgrade's scheduled retirement, if known.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "upgradeCopy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    },
    "MultiAgentVersion": {
      "description": "Multi-agent runtime supported by a model.",
      "enum": [
        "disabled",
        "v1",
        "v2"
      ],
      "type": "string"
    },
    "ReasoningEffort": {
      "description": "A non-empty reasoning effort value advertised by the model.",
      "minLength": 1,
      "type": "string"
    },
    "ReasoningEffortOption": {
      "properties": {
        "description": {
          "type": "string"
        },
        "reasoningEffort": {
          "$ref": "#/definitions/ReasoningEffort"
        }
      },
      "required": [
        "description",
        "reasoningEffort"
      ],
      "type": "object"
    },
    "SavedConnectionInfo": {
      "properties": {
        "id": {
          "$ref": "#/definitions/ConnectionText"
        },
        "name": {
          "$ref": "#/definitions/ConnectionText"
        },
        "provider": {
          "$ref": "#/definitions/SavedConnectionProvider"
        },
        "selection": {
          "$ref": "#/definitions/ConnectionSelection"
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "selection"
      ],
      "type": "object"
    },
    "SavedConnectionProvider": {
      "enum": [
        "openai",
        "copilot"
      ],
      "type": "string"
    }
  },
  "oneOf": [
    {
      "properties": {
        "data": {
          "items": {
            "$ref": "#/definitions/SavedConnectionInfo"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "connections"
          ],
          "title": "Connectionsv2::SavedConnectionResponseType",
          "type": "string"
        }
      },
      "required": [
        "data",
        "type"
      ],
      "title": "Connectionsv2::SavedConnectionResponse",
      "type": "object"
    },
    {
      "properties": {
        "data": {
          "items": {
            "$ref": "#/definitions/Model"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "prepared"
          ],
          "title": "Preparedv2::SavedConnectionResponseType",
          "type": "string"
        }
      },
      "required": [
        "data",
        "type"
      ],
      "title": "Preparedv2::SavedConnectionResponse",
      "type": "object"
    },
    {
      "properties": {
        "switchId": {
          "$ref": "#/definitions/ConnectionText"
        },
        "type": {
          "enum": [
            "selected"
          ],
          "title": "Selectedv2::SavedConnectionResponseType",
          "type": "string"
        }
      },
      "required": [
        "switchId",
        "type"
      ],
      "title": "Selectedv2::SavedConnectionResponse",
      "type": "object"
    },
    {
      "properties": {
        "challenge": {
          "$ref": "#/definitions/ConnectionLoginChallenge"
        },
        "loginId": {
          "$ref": "#/definitions/ConnectionText"
        },
        "type": {
          "enum": [
            "loginStarted"
          ],
          "title": "LoginStartedv2::SavedConnectionResponseType",
          "type": "string"
        }
      },
      "required": [
        "challenge",
        "loginId",
        "type"
      ],
      "title": "LoginStartedv2::SavedConnectionResponse",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "enum": [
            "settled"
          ],
          "title": "Settledv2::SavedConnectionResponseType",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Settledv2::SavedConnectionResponse",
      "type": "object"
    }
  ],
  "title": "SavedConnectionResponse"
}