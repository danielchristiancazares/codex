{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ConnectionLoginChallenge": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "browser"
              ],
              "title": "BrowserConnectionLoginChallengeType",
              "type": "string"
            },
            "url": {
              "$ref": "#/definitions/ConnectionText"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "title": "BrowserConnectionLoginChallenge",
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "$ref": "#/definitions/ConnectionText"
            },
            "type": {
              "enum": [
                "deviceCode"
              ],
              "title": "DeviceCodeConnectionLoginChallengeType",
              "type": "string"
            },
            "url": {
              "$ref": "#/definitions/ConnectionText"
            }
          },
          "required": [
            "code",
            "type",
            "url"
          ],
          "title": "DeviceCodeConnectionLoginChallenge",
          "type": "object"
        }
      ]
    },
    "ConnectionSelection": {
      "enum": [
        "retain",
        "switch"
      ],
      "type": "string"
    },
    "ConnectionText": {
      "description": "Bounded printable connection metadata, validated when decoding a request.",
      "type": "string"
    },
    "InputModality": {
      "description": "Canonical user-input modality tags advertised by a model.",
      "oneOf": [
        {
          "description": "Plain text turns and tool payloads.",
          "enum": [
            "text"
          ],
          "type": "string"
        },
        {
          "description": "Image attachments included in user turns.",
          "enum": [
            "image"
          ],
          "type": "string"
        },
        {
          "description": "Audio attachments included in user turns.",
          "enum": [
            "audio"
          ],
          "type": "string"
        }
      ]
    },
    "Model": {
      "properties": {
        "additionalSpeedTiers": {
          "default": [],
          "description": "Deprecated: use `serviceTiers` instead.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "availabilityNux": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelAvailabilityNux"
            },
            {
              "type": "null"
            }
          ]
        },
        "contextWindow": {
          "default": null,
          "description": "Curated normal context capacity; null selects the provider default.",
          "format": "int64",
          "minimum": 1.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "defaultReasoningEffort": {
          "$ref": "#/definitions/ReasoningEffort"
        },
        "defaultServiceTier": {
          "default": null,
          "description": "Catalog default service tier id for this model, when one is configured.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "inputModalities": {
          "default": [
            "text",
            "image"
          ],
          "items": {
            "$ref": "#/definitions/InputModality"
          },
          "type": "array"
        },
        "isDefault": {
          "type": "boolean"
        },
        "maxContextWindow": {
          "default": null,
          "description": "Maximum catalog capacity; null selects the provider default.",
          "format": "int64",
          "minimum": 1.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "modelSpecialty": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "multiAgentVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/MultiAgentVersion"
            },
            {
              "type": "null"
            }
          ],
          "description": "Multi-agent runtime declared by this model, when available."
        },
        "serviceTiers": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ModelServiceTier"
          },
          "type": "array"
        },
        "supportedReasoningEfforts": {
          "items": {
            "$ref": "#/definitions/ReasoningEffortOption"
          },
          "type": "array"
        },
        "supportsPersonality": {
          "default": false,
          "type": "boolean"
        },
        "upgrade": {
          "type": [
            "string",
            "null"
          ]
        },
        "upgradeInfo": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelUpgradeInfo"
            },
            {
              "type": "null"
            }
          ]
